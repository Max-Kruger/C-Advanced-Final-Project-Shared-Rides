@model Register
@{
    ViewData["Title"] = "Register";
}
<h2>Register</h2>
<form asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="FName" class="form-label">First Name</label>
        <input asp-for="FName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LName" class="form-label">Last Name</label>
        <input asp-for="LName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Username" class="form-label">Username</label>
        <input asp-for="Username" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
        <input asp-for="ConfirmPassword" class="form-control" />
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsDriver" class="form-check-input" type="checkbox" />
        <label asp-for="IsDriver" class="form-check-label">Sign up as a Driver</label>
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</form>