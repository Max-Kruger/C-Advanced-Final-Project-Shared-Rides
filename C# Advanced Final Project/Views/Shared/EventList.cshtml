@model List<Event>
@{
    var isAdmin = User.IsInRole("Admin");
}

@if (isAdmin)
{
    <div class="mb-2">
        <a asp-controller="Event" asp-action="Add">Add Event</a>
    </div>

}


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Location</th>
            <th>Date</th>
            <th>Riders</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <partial name="_DBTableItemsList"/>
        
    </tbody>
</table>
