@{
    var isAdmin = User.IsInRole("Admin");
    var isDriver = User.IsInRole("Driver");
    var signedUpIds = ViewBag.SignedUpEventIds as List<int?> ?? new List<int?>();
}
@foreach (var currEvent in Model)
{
    <tr>
        <td>@currEvent.Name</td>
        <td>@currEvent.Description</td>
        <td>@currEvent.Location</td>
        <td>@currEvent.EventDate</td>
        <td>@currEvent.Drivers</td>
        @if (isDriver && !isAdmin)
        {
            <td>
                @if (signedUpIds.Contains(currEvent.EventID))
                {
                    <span class="badge bg-success">Already Signed Up</span>
                }
                else
                {
                    <a asp-controller="Driver" asp-action="SignUpForEvent" asp-route-id="@currEvent.EventID" class="btn btn-sm btn-primary">Sign Up as Driver</a>
                }
            </td>
        }
        @if (isAdmin)
        {
            <td>
                <a asp-controller="Event" asp-action="Edit" asp-route-id="@currEvent.EventID">Edit</a>
            </td>
            <td>
                <a asp-controller="Event" asp-action="Delete" asp-route-id="@currEvent.EventID">Delete</a>
            </td>
        }
    </tr>
}